{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/postgres-adapter.test.mjs tests/admin-hash.test.mjs tests/database-target.test.mjs",
    "test:pg": "node --experimental-strip-types tests/postgres-adapter.integration.mjs",
    "release:check": "git diff --check && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "seo:audit": "node scripts/seo-audit.mjs",
    "db:generate": "drizzle-kit generate",
    "admin:hash": "node scripts/make-admin-hash.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
